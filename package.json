{
  "name": "motion-lab",
  "version": "1.0.0",
  "description": "电影级解说视频引擎 - 镜头语言驱动的 Remotion 视频系统",
  "private": true,
  "scripts": {
    "dev": "npx remotion studio",
    "render": "npx remotion render DemoVideo out/demo.mp4",
    "still": "npx remotion still DemoVideo out/demo.png --frame=60",
    "typecheck": "tsc --noEmit",
    "render:gpu": "npx remotion render DemoVideo out/demo.mp4 --gl=angle",
    "render:software": "npx remotion render DemoVideo out/demo-sw.mp4 --gl=swangle",
    "upgrade": "npx remotion upgrade"
  },
  "dependencies": {
    "@react-three/drei": "^9.117.0",
    "@react-three/fiber": "^8.17.10",
    "@react-three/postprocessing": "^2.19.1",
    "@remotion/captions": "4.0.535",
    "@remotion/cli": "4.0.535",
    "@remotion/three": "4.0.535",
    "@remotion/transitions": "4.0.535",
    "culori": "^4.0.2",
    "postprocessing": "^6.39.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "4.0.535",
    "remotion-bits": "^0.2.1",
    "three": "^0.182.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/culori": "^4.0.1",
    "@types/react": "^18.3.12",
    "@types/three": "^0.182.0",
    "typescript": "^5.6.3"
  }
}
