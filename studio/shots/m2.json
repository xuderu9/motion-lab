        "code": [
          "import { fetchPolicy } from './fetch-policy';",
          "import { normalize } from './normalize';",
          "",
          "// 一条政策 = 一个可追溯的记录",
          "export async function syncPolicy(id: string) {",
          "  const raw = await fetchPolicy(id);",
          "  const clean = normalize(raw);",
          "",
          "  if (!clean.effectiveAt) {",
          "    throw new Error('缺少生效日期');",
          "  }",
          "",
          "  return {",
          "    id: clean.id,",
          "    title: clean.title,",
          "    level: clean.level,",
          "    region: clean.region,",
          "    effectiveAt: clean.effectiveAt,",
          "    source: clean.sourceUrl,",
          "  };",
          "}",
          "",
          "// 批量同步：按发布时间倒序",
          "export async function syncAll(ids: string[]) {",
          "  return Promise.all(ids.map(syncPolicy));",
          "}",
          ""
        ],
        "statusRight": "已同步 1,284 条"
      },
      "overlay": {
